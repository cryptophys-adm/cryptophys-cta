{
  "$comment": "The CTA organ's DNA for the Cryptophys platform census (owner 2026-11-14: cryptophys-cta 'terhubung kernel'; ADR-0013 external organs). Served read-only by the OrganismDna RPC entrypoint (src/index.mjs) to the platform Forge over EXT_ORGANISM_CTA. External ceiling: tier 1, no council seat, signals.observe and reports.publish only. No AI task: no model writes public text here.",
  "schema": "cta-organism.v1",
  "organs": [
    {
      "$schema_version": 1,
      "service": "cryptophys-cta",
      "display_name": "Cryptophys CTA · content studio",
      "kind": "portal",
      "deploy_unit": null,
      "access": false,
      "rollback": false,
      "drift": {
        "via": "rpc",
        "binding": "EXT_CRYPTOPHYS_CTA"
      },
      "agents": [
        {
          "id": "cta-editor",
          "display_name": "CTA Editor",
          "capabilities": [
            "signals.observe",
            "reports.publish"
          ],
          "tier_max": 1,
          "voter": false
        },
        {
          "id": "cta-guardian",
          "display_name": "CTA Content Guardian",
          "capabilities": [
            "signals.observe",
            "reports.publish"
          ],
          "tier_max": 1,
          "voter": false
        }
      ],
      "engines": []
    }
  ],
  "deploy": {
    "$comment": "What the platform's native deploy (Forge + Deployment Orchestrator, owner 2026-11-15: 'gunakan native deployment pakai forge') needs to deploy this organ (ADR-0018 repository contract). Every non-secret value is a plain var in wrangler.jsonc. wrangler.jsonc is the source of truth; test/app.test.mjs keeps this block equal to it. The organ's own deploy_unit stays null: the census refuses an external organ that claims a platform unit. Until the Forge deploys external organs, .github/workflows/deploy.yml deploys from main (owner 2026-11-16) and runs this block's health and smoke checks.",
    "unit": "cryptophys-cta",
    "via": "forge",
    "script": "cryptophys-cta",
    "config": "wrangler.jsonc",
    "entry": "src/index.mjs",
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "build": "npm ci (package-lock.json; one runtime dependency, @cloudflare/puppeteer, bundled by wrangler)",
    "tests": "node --test test/*.test.mjs",
    "dry_run": "wrangler deploy --dry-run",
    "custom_domains": [
      "cta.cryptophys.work"
    ],
    "workers_dev": false,
    "assets": {
      "directory": "./public",
      "binding": "ASSETS",
      "run_worker_first": [
        "/health",
        "/api/*",
        "/studio",
        "/studio/*",
        "/media/*",
        "/go/*"
      ]
    },
    "durable_objects": [
      {
        "binding": "CONTENT_DESK",
        "class_name": "ContentDesk"
      }
    ],
    "do_migrations": [
      {
        "tag": "v1",
        "new_sqlite_classes": [
          "ContentDesk"
        ]
      }
    ],
    "services": [
      {
        "binding": "PROJECTION",
        "service": "xauusd-ai-trading-assistant",
        "entrypoint": "PublicProjection"
      }
    ],
    "browser": {
      "binding": "BROWSER"
    },
    "entrypoints": [
      "OrganismDna",
      "CtaHealth"
    ],
    "crons": [
      "17 22 * * 2-6",
      "9 * * * 1-5",
      "*/5 * * * *"
    ],
    "vars": [
      "CONTENT_PUBLISH",
      "PUBLISH_CHANNELS",
      "CONTENT_CHANNELS",
      "PUBLIC_DELAY_HOURS",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
      "PUBLIC_ORIGIN",
      "CONTENT_INSIGHTS"
    ],
    "secrets_kept": [
      "THREADS_ACCESS_TOKEN",
      "THREADS_USER_ID",
      "INSTAGRAM_ACCESS_TOKEN",
      "INSTAGRAM_USER_ID",
      "X_ACCESS_TOKEN",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "YOUTUBE_CLIENT_ID",
      "YOUTUBE_CLIENT_SECRET",
      "YOUTUBE_REFRESH_TOKEN",
      "TIKTOK_CLIENT_KEY",
      "TIKTOK_CLIENT_SECRET",
      "TIKTOK_REFRESH_TOKEN",
      "STUDIO_APPROVERS",
      "THREADS_APP_ID",
      "THREADS_APP_SECRET",
      "INSTAGRAM_APP_ID",
      "INSTAGRAM_APP_SECRET",
      "X_CLIENT_ID",
      "X_CLIENT_SECRET",
      "TOKEN_ENC_KEY"
    ],
    "health": {
      "path": "/health",
      "expect": {
        "ok": true,
        "service": "cryptophys-cta"
      }
    },
    "smoke": [
      {
        "path": "/api/studio/drafts",
        "expect_status": [
          302,
          403
        ]
      },
      {
        "path": "/api/public/profile",
        "expect_status": [
          200
        ]
      },
      {
        "path": "/media/00000000000000000000000000000000.jpg",
        "expect_status": [
          404
        ]
      }
    ]
  }
}
