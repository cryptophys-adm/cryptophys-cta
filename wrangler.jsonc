{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptophys-cta",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  // nodejs_compat: @cloudflare/puppeteer (Browser Run) needs Node's built-ins.
  "compatibility_flags": ["nodejs_compat"],
  // cta.cryptophys.work (owner 2026-11-14/15): the content studio (behind Cloudflare Access; the Worker verifies the
  // JWT itself, fail closed) and the public CTA page. No workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cta.cryptophys.work", "custom_domain": true }
  ],
  // The only data source: the xauusd AI Worker's PublicProjection (recaps after 24 hours; real-time analysis with
  // key levels and patterns; never a decision, plan or account). Read-only RPC over a Service Binding.
  "services": [
    { "binding": "PROJECTION", "service": "xauusd-ai-trading-assistant", "entrypoint": "PublicProjection" }
  ],
  // Browser Run: the Instagram cards (TradingView's own chart widget plus the Cryptophys panel, src/card.mjs),
  // screenshotted right after drafting. 10 browser hours a month are included; a card takes about 7 seconds.
  "browser": { "binding": "BROWSER" },
  // The approval queue, the published archive and the refreshed tokens: one Durable Object with SQLite storage.
  "durable_objects": {
    "bindings": [
      { "name": "CONTENT_DESK", "class_name": "ContentDesk" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ContentDesk"] }
  ],
  // The recap Tuesday to Saturday at 22:17 UTC (05:17 WIB); the analysis every hour at :09 Monday to Friday, with the
  // key-level map at 06:09 UTC (13:09 WIB).
  "triggers": {
    "crons": ["17 22 * * 2-6", "9 * * * 1-5", "*/5 * * * *"]
  },
  "vars": {
    // Nothing is published while this is "off": an approved draft waits. Turning it on is an owner PR, after the
    // lawyer's check of POJK 6/2026 and once the accounts' secrets are in. Owner 2026-11-17 (the check done): "on",
    // for the channels in PUBLISH_CHANNELS only; "kita sambungkan dulu ke Telegram setelah sukses baru ke channel lain".
    "CONTENT_PUBLISH": "on",
    // The channels that publish while CONTENT_PUBLISH is "on". Unset or empty: none. One channel at a time, each in
    // an owner PR. Every post still waits for a person's approval in the studio.
    // Owner 2026-11-17: Telegram first; Threads after Telegram's first post went out (06:15 UTC) and @cryptophys.adm
    // was connected by OAuth ("ya lanjutkan"). Instagram after Threads' first post went out (owner 2026-11-17: "lanjutkan
    // penerbitan instagram", confirmed in the session): an image post (the card), so it needs the card rendered and an
    // Instagram Business or Creator account connected in the studio; until then an approved post waits ("account not connected").
    "PUBLISH_CHANNELS": "telegram,threads,instagram",
    "CONTENT_CHANNELS": "threads,instagram,x,telegram,youtube,tiktok",
    "PUBLIC_DELAY_HOURS": "24",
    "ACCESS_TEAM_DOMAIN": "cryptophys.cloudflareaccess.com",
    // The audience tag of the platform's Access application (the one that covers nexus., ai. and the studio paths
    // here); read from its login redirect (kid). Not a secret. A plain var, so the deploy needs no Access read right.
    "ACCESS_AUD": "33c6d911ba06a57f6dbe2fa3c1c62a5850dba526b4458fc92bad394136668965",
    // The origin of the public card URLs Instagram fetches (GET /media/<id>.jpg, only once a draft is approved).
    "PUBLIC_ORIGIN": "https://cta.cryptophys.work",
    // The channels whose post metrics are read once a day (src/insights.mjs). X is not listed: X bills each read.
    "CONTENT_INSIGHTS": "threads,instagram,youtube"
  },
  // The public page and the studio page (no build step). run_worker_first: the JWT is checked before any studio asset.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
