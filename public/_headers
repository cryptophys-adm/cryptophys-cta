# The security headers of every static file (the Worker sets the same on what it answers: SECURITY_HEADERS in
# src/app.mjs; test/room.test.mjs keeps the two equal). Not served itself. frame-src: the home page's TradingView quote
# (owner 2026-11-20), its widget frame's host only; the page runs no TradingView script.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; font-src 'self'; frame-src https://www.tradingview-widget.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Kept for a year (frontend audit 2026-11-22): each of these files is named with its hash in the URL (the scene, the
# mannequin; home.css, home.js, performance.js and archive.js in the pages, scripts/versions.mjs) or never changes under its name
# (the fonts, named by family, weight and style). The pages themselves are revalidated on every visit.
/room/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/home.css
  Cache-Control: public, max-age=31536000, immutable
/home.js
  Cache-Control: public, max-age=31536000, immutable
/performance.js
  Cache-Control: public, max-age=31536000, immutable
/archive.js
  Cache-Control: public, max-age=31536000, immutable
